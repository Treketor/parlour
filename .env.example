# Copy to .env.local and fill in. The two NEXT_PUBLIC_ values are public by
# design: the publishable key only grants what row-level security allows.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server only. Never prefix these with NEXT_PUBLIC_.
# Twitch app for IGDB (dev.twitch.tv/console, client type Confidential).
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Supabase secret key (Project Settings, API Keys): writes the shared catalogue.
SUPABASE_SECRET_KEY=sb_secret_...
# Optional. RAWG (rawg.io/apidocs, free for personal use with a link to RAWG):
# Metacritic's metascore and RAWG's player rating on game pages.
RAWG_API_KEY=
